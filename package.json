{
  "name": "natoursapp",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "jest --runInBand",
    "start": "node server.js",
    "start:dev": "nodemon server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "debug": "NODE_ENV=production node --inspect server.js",
    "watch:js": "esbuild ./public/js/index.js --bundle --sourcemap --target=es2018 --outfile=./public/js/bundle.js --watch",
    "build:js": "esbuild ./public/js/index.js --bundle --minify --sourcemap --target=es2018 --outfile=./public/js/bundle.js",
    "test:coverage": "jest --runInBand --coverage"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pug": "^3.0.4",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.4",
    "stripe": "^22.6.2",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^8.52.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^30.5.2",
    "prettier": "^3.0.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 30000,
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/public/js/bundle.js"
    ]
  }
}
