extends base

block content
  main.main
    .login-form
      h2.heading-secondary.ma-bt-lg Forgot your password?
      p.notice.ma-bt-md Enter your email and we will send you a link to reset your password.
      form.form.form--forgot
        .form__group.ma-bt-md
          label.form__label(for='email') Email address
          input#email.form__input(type='email', placeholder='you@example.com', required, autocomplete='email')
        .form__group
          button.btn.btn--green Send reset link
