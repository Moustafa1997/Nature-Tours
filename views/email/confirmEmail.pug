extends base_email 
block content 
    p Hi #{firstName},
        p Welcome to Natours, we're glad to have you 🎉🙏
        p Please confirm your email address so you can start booking tours. The link is valid for 24 hours.
        table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
            tbody
                tr
                    td(align='left')
                        table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                            tbody
                                tr
                                    td
                                        a(href=`${url}`, target='_blank') Confirm my email
        p If you didn't create an account, please ignore this email!
