mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

mixin accountNav(active)
  nav.user-view__menu
    ul.side-nav
      +navItem('/me', 'Settings', 'settings', active === 'settings')
      +navItem('/my-tours', 'My bookings', 'briefcase', active === 'bookings')
      +navItem('/my-favorites', 'My favorites', 'heart', active === 'favorites')
      +navItem('/my-reviews', 'My reviews', 'star', active === 'reviews')

    - if (user.role === 'admin')
      .admin-nav
        h5.admin-nav__heading Admin
        ul.side-nav
          +navItem('/api/v1/tours', 'Manage tours', 'map')
          +navItem('/api/v1/users', 'Manage users', 'users')
          +navItem('/api/v1/reviews', 'Manage reviews', 'star')
          +navItem('/api/v1/bookings/userBookings', 'Manage bookings', 'briefcase')
